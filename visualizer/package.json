{
  "name": "automapops-visualizer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "generate:types": "node scripts/generate-types.mjs",
    "check:types": "node scripts/check-generated-types.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "benchmark": "vitest run benchmarks/performance.benchmark.ts"
  },
  "dependencies": {
    "@deck.gl/core": "^9.3.11",
    "@deck.gl/extensions": "^9.3.11",
    "@deck.gl/layers": "^9.3.11",
    "ajv": "^8.20.0",
    "flatbush": "^4.6.2",
    "pinia": "^4.0.3",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "jsdom": "^26.1.0",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.1.5"
  }
}
